# ===========================================
# MOCKUP GENERATOR - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Claude API Key (REQUIRED)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Unsplash API Key (OPTIONAL - for stock image fallback)
# Get your key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Google Places API Key (OPTIONAL - for Google Business images)
# Get your key at: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=your-google-api-key

# SerpAPI Key (OPTIONAL - RECOMMENDED for better Google Images/Business results)
# Get your key at: https://serpapi.com/
# This provides the best quality results for Google Business Photos and Google Images
SERPAPI_KEY=your-serpapi-key
